# ==========================================
# SUPABASE API CONFIGURATION
# ==========================================
# 1. Go to your Supabase Dashboard -> Project Settings -> API
# 2. Copy the "Project URL" and paste it below:
SUPABASE_URL=https://your-project.supabase.co

# 3. On the same API page, scroll down to "JWT Settings"
# 4. Reveal and copy the "JWT Secret" and paste it below:
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# 1. Go to your Supabase Dashboard -> Project Settings -> Database
# 2. Scroll to "Connection string" and select "URI"
# 3. Replace [YOUR-PASSWORD] with your actual database password
# 4. IMPORTANT: Change the prefix from "postgresql://" to "postgresql+asyncpg://"
DATABASE_URL=postgresql+asyncpg://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# ==========================================
# APP CONFIGURATION
# ==========================================
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
